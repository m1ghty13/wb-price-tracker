# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администраторов бота через запятую (например: 123456789,987654321)
# Администраторы имеют доступ к /admin_stats и /broadcast
ADMIN_IDS=123456789

# Список разрешённых пользователей через запятую (например: 111,222,333)
# Пусто = открытый бот, любой пользователь может использовать
ALLOWED_USERS=

# Интервал проверки цен товаров в часах
CHECK_INTERVAL_HOURS=2

# Максимальное количество товаров на одного пользователя
MAX_PRODUCTS_PER_USER=50

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Путь к файлу базы данных SQLite
DATABASE_PATH=data/tracker.db

# Таймаут HTTP-запросов к Wildberries API в секундах
WB_REQUEST_TIMEOUT=10

# Максимальное количество повторных попыток при ошибке запроса к WB
WB_MAX_RETRIES=3
